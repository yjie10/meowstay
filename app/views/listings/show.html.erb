<div class="max-w-3xl mx-auto px-6 py-8">
  <h1 class="text-3xl font-bold text-amber-700 mb-6">
    🐾 <%= @listing.kitty_name %>'s Profile 🐾
  </h1>

  <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 space-y-3">
    <img src="https://robohash.org/<%= @listing.id%>?set=set4" class="w-24 h-24 rounded-full mx-auto mb-3" />
    <p><strong>Breed:</strong> <%= @listing.breed %></p>
    <p><strong>Age:</strong> <%= @listing.age %> year(s)</p>
    <p><strong>Gender:</strong> <%= @listing.gender %></p>
    <p><strong>Location:</strong> <%= @listing.location %></p>
    <p><strong>Personality:</strong> <%= @listing.personality&.join(", ") %></p>
    <p class="text-gray-600 mt-4"><%= @listing.description %></p>
  </div>

  <%= link_to "← Back to Listings", listings_path, class: "inline-block mt-6 text-amber-500 hover:text-amber-600 hover:underline" %>
</div>
