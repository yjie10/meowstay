<div class="m-4">
  <h1 class="text-amber-700 text-3xl font-bold mb-6">🐾 Meowstay Listings 🐾</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    <% @listings.each do |listing| %>
      <div class="bg-white rounded-xl shadow-md p-4 border border-gray-100 hover:shadow-lg transition">
        <img src="https://robohash.org/<%= listing.id%>?set=set4" class="w-24 h-24 rounded-full mx-auto mb-3 border-4 border-amber-200 shadow-md" />
        <h2 class="text-xl font-semibold mb-2"><%= listing.kitty_name %> <span class="text-sm text-gray-500">· <%= listing.gender %></span></h2>
        <p class="text-gray-600 mb-1">Breed: <%= listing.breed %></p>
        <p class="text-gray-600 mb-1">Age: <%= listing.age %> year(s)</p>
        <p class="text-gray-600 mb-1">Location: <%= listing.location %></p>
        <p class="text-gray-600 mb-1">Personality: <%= listing.personality&.join(", ") %></p>
        <%= link_to "View Details", listing_path(listing), class: "text-amber-500 hover:text-amber-600 hover:underline mt-4 inline-block text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>